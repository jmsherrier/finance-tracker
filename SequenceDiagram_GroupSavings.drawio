          <mxGeometry x="55" y="380" width="10" height="80" as="geometry" />
        </mxCell>
        <mxCell id="msg1" value="1: requestJoinCircle(circleId)" style="html=1;verticalAlign=bottom;endArrow=block;entryX=0;entryY=0;rounded=0;" parent="1" source="lifeline_user" target="lifeline_savingcircle" edge="1">
