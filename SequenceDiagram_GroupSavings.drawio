        <mxCell id="title" value="Sequence Diagram: User Joins a Saving Circle&#xa;&#xa;Description: This diagram shows the process when a user attempts to join an existing saving circle. The system validates the circle exists and creates a membership, then sends a notification to the user." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="40" y="20" width="1020" height="80" as="geometry" />
        </mxCell>
