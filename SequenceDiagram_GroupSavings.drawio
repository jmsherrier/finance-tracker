          <mxGeometry x="80" y="120" width="30" height="60" as="geometry" />
        </mxCell>
        <mxCell id="lifeline_user" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
