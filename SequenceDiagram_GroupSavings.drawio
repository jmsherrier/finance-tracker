        </mxCell>
        <mxCell id="obj_membership" value=":CircleMembership" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="520" y="120" width="140" height="580" as="geometry" />
        </mxCell>
        <mxCell id="lifeline_membership" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#d5e8d4;strokeColor=#82b366;" parent="obj_membership" vertex="1">
